{
  "manifest_version": 3,
  "name": "AdBlocker Plugin",
  "short_name": "AdBlocker",
  "version": "1.0.0",
  "description": "Fast, private ad and tracker blocker built on Chrome's declarativeNetRequest engine.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AdBlocker",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["generated/cosmetic-data.js", "src/content/cosmetic.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "generated/rulesets/ads.json" },
      { "id": "trackers", "enabled": true, "path": "generated/rulesets/trackers.json" },
      { "id": "social", "enabled": false, "path": "generated/rulesets/social.json" },
      { "id": "annoyances", "enabled": false, "path": "generated/rulesets/annoyances.json" }
    ]
  }
}
